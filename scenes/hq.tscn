[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hq.gd" id="1_hq"]
[ext_resource type="PackedScene" path="res://scenes/ui/ship_builder.tscn" id="2_builder"]
[ext_resource type="Script" path="res://scripts/ui/focus_panel.gd" id="3_focus"]

[node name="HQ" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_hq")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.018, 0.03, 0.052, 1)

[node name="Layout" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="Column" type="VBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Layout/Column"]
layout_mode = 2

[node name="Brand" type="VBoxContainer" parent="Layout/Column/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="Layout/Column/Header/Brand"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.9, 1, 1)
theme_override_font_sizes/font_size = 30
text = "SPACEDELIVERY / HOME BASE"

[node name="Subtitle" type="Label" parent="Layout/Column/Header/Brand"]
layout_mode = 2
theme_override_colors/font_color = Color(0.64, 0.74, 0.84, 1)
text = "Your package. Our problem."

[node name="AccountBalance" type="Label" parent="Layout/Column/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(210, 0)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.3, 1)
theme_override_font_sizes/font_size = 18
text = "CREDITS / 0 CR"
horizontal_alignment = 2
vertical_alignment = 1

[node name="Main" type="HBoxContainer" parent="Layout/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 14

[node name="MissionSlot" type="Control" parent="Layout/Column/Main"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Center" type="VBoxContainer" parent="Layout/Column/Main"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.7
theme_override_constants/separation = 8

[node name="BuilderPanel" type="PanelContainer" parent="Layout/Column/Main/Center"]
layout_mode = 2
size_flags_vertical = 3

[node name="ShipBuilder" parent="Layout/Column/Main/Center/BuilderPanel" instance=ExtResource("2_builder")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="CenterActions" type="VBoxContainer" parent="Layout/Column/Main/Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="TestFlightButton" type="Button" parent="Layout/Column/Main/Center/CenterActions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
text = "TEST FLIGHT"

[node name="SkillSlot" type="Control" parent="Layout/Column/Main"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Footer" type="HBoxContainer" parent="Layout/Column"]
layout_mode = 2

[node name="FooterLabel" type="Label" parent="Layout/Column/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.43, 0.7, 0.8, 1)
text = "HQ / CENTRAL DOCK"
horizontal_alignment = 1

[node name="PanelLayer" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Dim" type="ColorRect" parent="PanelLayer"]
visible = false
z_index = 5
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.008, 0.015, 0.028, 0.8)

[node name="MissionPanel" type="PanelContainer" parent="PanelLayer" groups=["hq_focus_panels"]]
layout_mode = 0
script = ExtResource("3_focus")
slot = NodePath("../../Layout/Column/Main/MissionSlot")
dim = NodePath("../Dim")
focus_size = Vector2(680, 620)

[node name="MissionVBox" type="VBoxContainer" parent="PanelLayer/MissionPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="MissionHeader" type="HBoxContainer" parent="PanelLayer/MissionPanel/MissionVBox"]
layout_mode = 2

[node name="MissionTitle" type="Label" parent="PanelLayer/MissionPanel/MissionVBox/MissionHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.45, 0.9, 1, 1)
theme_override_font_sizes/font_size = 25
text = "MISSION BOARD"

[node name="MissionClose" type="Button" parent="PanelLayer/MissionPanel/MissionVBox/MissionHeader"]
layout_mode = 2
text = "✕"

[node name="WelcomeContent" type="VBoxContainer" parent="PanelLayer/MissionPanel/MissionVBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="WelcomeText" type="Label" parent="PanelLayer/MissionPanel/MissionVBox/WelcomeContent"]
unique_name_in_owner = true
layout_mode = 2
text = "Browse available contracts."
autowrap_mode = 3

[node name="StatusPanel" type="PanelContainer" parent="PanelLayer/MissionPanel/MissionVBox/WelcomeContent"]
unique_name_in_owner = true
layout_mode = 2

[node name="StatusLabel" type="Label" parent="PanelLayer/MissionPanel/MissionVBox/WelcomeContent/StatusPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.48, 0.83, 0.7, 1)
text = "SELECT A CONTRACT"
autowrap_mode = 3

[node name="MissionActions" type="VBoxContainer" parent="PanelLayer/MissionPanel/MissionVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="SkillPanel" type="PanelContainer" parent="PanelLayer" groups=["hq_focus_panels"]]
layout_mode = 0
script = ExtResource("3_focus")
slot = NodePath("../../Layout/Column/Main/SkillSlot")
dim = NodePath("../Dim")
focus_size = Vector2(680, 620)

[node name="SkillVBox" type="VBoxContainer" parent="PanelLayer/SkillPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SkillHeader" type="HBoxContainer" parent="PanelLayer/SkillPanel/SkillVBox"]
layout_mode = 2

[node name="SkillTitle" type="Label" parent="PanelLayer/SkillPanel/SkillVBox/SkillHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.95, 0.85, 0.5, 1)
theme_override_font_sizes/font_size = 25
text = "UPGRADE PANEL & SKILL TREE"

[node name="SkillClose" type="Button" parent="PanelLayer/SkillPanel/SkillVBox/SkillHeader"]
layout_mode = 2
text = "✕"

[node name="SkillSubtitle" type="Label" parent="PanelLayer/SkillPanel/SkillVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.69, 0.78, 0.87, 1)
text = "PERMANENT ACCOUNT UPGRADES"

[node name="SkillTree" type="VBoxContainer" parent="PanelLayer/SkillPanel/SkillVBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="SkillCredits" type="Label" parent="PanelLayer/SkillPanel/SkillVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.3, 1)
theme_override_font_sizes/font_size = 20
text = "CREDITS: 0"
horizontal_alignment = 1

[connection signal="pressed" from="Layout/Column/Main/Center/CenterActions/TestFlightButton" to="." method="_on_test_flight_pressed"]
[connection signal="pressed" from="PanelLayer/MissionPanel/MissionVBox/MissionHeader/MissionClose" to="PanelLayer/MissionPanel" method="unfocus"]
[connection signal="pressed" from="PanelLayer/SkillPanel/SkillVBox/SkillHeader/SkillClose" to="PanelLayer/SkillPanel" method="unfocus"]
