[gd_resource type="Resource" script_class="MissionDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/missions/mission_definition.gd" id="1_mission"]
[ext_resource type="Script" path="res://scripts/missions/mission_route_node.gd" id="2_node"]

[sub_resource type="Resource" id="licensed_lane"]
script = ExtResource("2_node")
node_id = &"licensed_lane"
title = "Licensed Trade Lane"
description = "Routine traffic and toll fees. Fewer surprises, if the paperwork is current."
node_kind = 1
risk = 1
bonus_credits = 10
encounter_profile = 1
depth = 1
lane = 0

[sub_resource type="Resource" id="debris_cut"]
script = ExtResource("2_node")
node_id = &"debris_cut"
title = "Debris Cut"
description = "A short passage through a derelict freight field. Salvage crews are advised to sign the waiver."
node_kind = 1
risk = 2
bonus_credits = 80
encounter_profile = 2
depth = 1
lane = 1

[resource]
script = ExtResource("1_mission")
mission_id = &"fragile_relay_parts"
title = "Fragile Relay Components"
client_name = "Outer Ring Communications"
cargo_name = "Kestrel Precision Relay Kit"
cargo_type = "Fragile Electronics"
cargo_variant = 1
cargo_description = "Precision relay components in shock-sensitive packaging. Any surviving shipment can be delivered, but full payment requires pristine condition."
cargo_value_credits = 560
cargo_damage_sensitivity = 1.3
minimum_delivery_integrity_percent = 1
full_reward_integrity_percent = 100
damaged_cargo_payout_penalty_percent = 40
destination_name = "Kestrel Relay Station"
briefing = "The customer requires a pristine delivery and a signed receipt. Their contract defines 'pristine' in a separate document that was not included."
base_reward_credits = 190
risk_label = "Elevated"
recommended_power_min = 95
recommended_power_max = 130
layer_node_counts = Array[int]([1, 2, 3, 2, 1])
branch_chance = 0.55
risk_bias = 1
fixed_beats = Array[ExtResource("2_node")]([SubResource("licensed_lane"), SubResource("debris_cut")])
