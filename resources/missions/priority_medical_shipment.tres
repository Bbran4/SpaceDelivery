[gd_resource type="Resource" script_class="MissionDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/missions/mission_definition.gd" id="1_mission"]
[ext_resource type="Script" path="res://scripts/missions/mission_route_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/missions/mission_phase_definition.gd" id="3_phase"]

[sub_resource type="Resource" id="quiet_corridor"]
script = ExtResource("2_node")
node_id = &"quiet_corridor"
title = "Quiet Corridor"
description = "Lower chance of hostile contact. Little salvage expected."
node_kind = 1
risk = 1
bonus_credits = 15
encounter_profile = 1
depth = 1
lane = 0

[sub_resource type="Resource" id="salvage_lane"]
script = ExtResource("2_node")
node_id = &"salvage_lane"
title = "Salvage Lane"
description = "Unstable wreck field. Greater threat, better recovery prospects."
node_kind = 1
risk = 2
bonus_credits = 65
encounter_profile = 2
depth = 1
lane = 1

[sub_resource type="Resource" id="phase_asteroid_bounty"]
script = ExtResource("3_phase")
phase_id = &"asteroid_bounty"
title = "Asteroid Bounty"
briefing = "A dense, shifting asteroid wall blocks the outbound lane. Destroy all 36 blocking rocks within 60 seconds. Your starter weapons are badly underpowered for this field; expect to need better equipment and another attempt."
phase_type = 0
duration_seconds = 60
target_count = 36
bonus_credits = 20

[sub_resource type="Resource" id="phase_pirate_ambush"]
script = ExtResource("3_phase")
phase_id = &"pirate_ambush"
title = "Pirate Ambush"
briefing = "Clear the pirate ambush with your equipped weapons."
phase_type = 1
duration_seconds = 60
target_count = 4
bonus_credits = 35

[sub_resource type="Resource" id="phase_final_delivery"]
script = ExtResource("3_phase")
phase_id = &"final_delivery"
title = "Final Delivery"
briefing = "Travel the long outbound leg to Vesper Clinic Ring, line up with the orbital docking approach, and confirm the medical shipment delivery."
phase_type = 2
duration_seconds = 60
target_count = 1
bonus_credits = 0

[resource]
script = ExtResource("1_mission")
mission_id = &"medical_priority"
title = "Priority Medical Shipment"
client_name = "Helix Regional Clinics"
cargo_name = "Clinic Cold-Chain Pack"
cargo_type = "Temperature-Controlled Medical Supplies"
cargo_variant = 0
cargo_description = "Sealed vaccine carriers and essential clinic supplies. Keep the shipment above the minimum safe integrity threshold."
cargo_value_credits = 420
cargo_damage_sensitivity = 1.1
minimum_delivery_integrity_percent = 50
full_reward_integrity_percent = 75
damaged_cargo_payout_penalty_percent = 30
destination_name = "Vesper Clinic Ring"
briefing = "A clinic network is running low on essential supplies. The shipment is sealed, time-sensitive, and accompanied by a very specific liability waiver."
base_reward_credits = 240
risk_label = "Standard"
recommended_power_min = 80
recommended_power_max = 110
layer_node_counts = Array[int]([1, 2, 3, 2, 1])
branch_chance = 0.55
risk_bias = 0
fixed_beats = Array[ExtResource("2_node")]([SubResource("quiet_corridor"), SubResource("salvage_lane")])
phases = Array[ExtResource("3_phase")]([SubResource("phase_asteroid_bounty"), SubResource("phase_pirate_ambush"), SubResource("phase_final_delivery")])
