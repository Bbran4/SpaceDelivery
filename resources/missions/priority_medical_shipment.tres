[gd_resource type="Resource" script_class="MissionDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/mission_definition.gd" id="1_mission"]
[ext_resource type="Script" path="res://scripts/mission_route_node.gd" id="2_node"]

[sub_resource type="Resource" id="quiet_corridor"]
script = ExtResource("2_node")
node_id = &"quiet_corridor"
title = "Quiet Corridor"
description = "Lower chance of hostile contact. Little salvage expected."
node_kind = 1
risk = 1
bonus_credits = 15
encounter_profile = 1
depth = 1
lane = 0

[sub_resource type="Resource" id="salvage_lane"]
script = ExtResource("2_node")
node_id = &"salvage_lane"
title = "Salvage Lane"
description = "Unstable wreck field. Greater threat, better recovery prospects."
node_kind = 1
risk = 3
bonus_credits = 65
encounter_profile = 2
depth = 1
lane = 1

[resource]
script = ExtResource("1_mission")
mission_id = &"medical_priority"
title = "Priority Medical Shipment"
client_name = "Helix Regional Clinics"
cargo_name = "Clinic Cold-Chain Pack"
cargo_type = "Temperature-Controlled Medical Supplies"
cargo_description = "Sealed vaccine carriers and essential clinic supplies. Keep the shipment above the minimum safe integrity threshold."
cargo_value_credits = 420
cargo_damage_sensitivity = 1.1
minimum_delivery_integrity_percent = 50
full_reward_integrity_percent = 75
damaged_cargo_payout_penalty_percent = 30
destination_name = "Vesper Clinic Ring"
briefing = "A clinic network is running low on essential supplies. The shipment is sealed, time-sensitive, and accompanied by a very specific liability waiver."
base_reward_credits = 240
risk_label = "Standard"
layer_node_counts = Array[int]([1, 2, 3, 2, 1])
branch_chance = 0.55
risk_bias = 0
fixed_beats = Array[ExtResource("2_node")]([SubResource("quiet_corridor"), SubResource("salvage_lane")])
